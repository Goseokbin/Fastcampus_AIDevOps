{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform init:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform show:*)",
      "Bash(tflint:*)",
      "Bash(checkov:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl events:*)",
      "Bash(kubectl top:*)",
      "Bash(kubectl rollout status:*)",
      "Bash(kubectl rollout history:*)",
      "Bash(kubectl config current-context)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(kubeconform:*)",
      "Bash(yq:*)",
      "Bash(argocd app get:*)",
      "Bash(argocd app diff:*)",
      "Bash(argocd app history:*)",
      "Bash(argocd app list:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch -c:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(./tests/smoke.sh:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(podman build:*)",
      "Bash(podman images:*)",
      "Bash(podman inspect:*)",
      "Bash(podman save:*)",
      "Bash(trivy image:*)",
      "mcp__argocd",
      "mcp__eks",
      "mcp__grafana"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)",
      "mcp__slack__slack_send_message",
      "mcp__slack__slack_send_message_draft",
      "mcp__slack__slack_schedule_message",
      "mcp__slack__slack_add_reaction",
      "mcp__slack__slack_read_channel",
      "mcp__slack__slack_read_thread",
      "mcp__slack__slack_read_file",
      "mcp__slack__slack_read_list",
      "mcp__slack__slack_read_user_profile",
      "mcp__slack__slack_get_reactions",
      "mcp__slack__slack_list_channel_members",
      "mcp__slack__slack_list_user_channels"
    ],
    "deny": [
      "mcp__slack__slack_search_public",
      "mcp__slack__slack_search_public_and_private",
      "mcp__slack__slack_search_channels",
      "mcp__slack__slack_search_users",
      "mcp__slack__slack_search_emojis",
      "mcp__slack__slack_create_conversation",
      "mcp__slack__slack_create_canvas",
      "mcp__slack__slack_update_canvas",
      "mcp__slack__slack_read_canvas",
      "mcp__slack__slack_get_file_upload_url",
      "mcp__slack__slack_complete_file_upload",
      "mcp__slack__slack_create_list",
      "mcp__slack__slack_update_list",
      "mcp__slack__slack_add_list_record",
      "mcp__slack__slack_update_list_record",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl create:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl patch:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl scale:*)",
      "Bash(kubectl set:*)",
      "Bash(kubectl rollout restart:*)",
      "Bash(kubectl rollout undo:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl get secret:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(argocd app sync:*)",
      "Bash(argocd app delete:*)",
      "Bash(argocd app set:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(./scenarios/*)",
      "Bash(bash scenarios/*)",
      "Bash(aws s3 rm:*)",
      "Bash(aws s3 rb:*)",
      "Bash(aws s3api delete-bucket:*)",
      "Bash(aws s3api delete-object:*)",
      "Bash(aws s3api delete-objects:*)",
      "Bash(aws ecr delete-repository:*)",
      "Bash(aws ecr batch-delete-image:*)",
      "Bash(aws eks delete-cluster:*)",
      "Bash(aws eks delete-nodegroup:*)",
      "Bash(aws eks delete-addon:*)",
      "Bash(aws ec2 delete-vpc:*)",
      "Bash(aws ec2 delete-subnet:*)",
      "Bash(aws ec2 delete-nat-gateway:*)",
      "Bash(aws ec2 delete-security-group:*)",
      "Bash(aws ec2 delete-volume:*)",
      "Bash(aws ec2 delete-network-interface:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Bash(aws elbv2 delete-load-balancer:*)",
      "Bash(aws iam delete-role:*)",
      "Bash(aws iam delete-policy:*)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/.terraform/**)",
      "Read(./**/*.tfvars)",
      "Read(./.env)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(./course/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-kube-context.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-validate.sh" }
        ]
      }
    ]
  }
}
